{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start NeuroScan Server",
            "type": "shell",
            "command": "node server.js",
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": ".*(PORT|localhost:8080).*"
                }
            }
        }
    ]
}
